{
  "env": {
    "PONYTAIL_SUBAGENT_MATCHER": "^(implementer|reviewer)$"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "WORK_BRAIN_ROOT=\"$CLAUDE_PROJECT_DIR\" node \"$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch-log.js\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "WORK_BRAIN_ROOT=\"$CLAUDE_PROJECT_DIR\" node \"$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch-log.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ask_guard.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/lead_reply.py\""
          }
        ]
      }
    ]
  }
}
